<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_start">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glow_overlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <FrameLayout
            android:id="@+id/emergencyPulse"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:background="@drawable/bg_sos_glow"
            android:padding="34dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_red_soft"
                android:padding="32dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Emergency"
                    android:src="@drawable/ic_siren"
                    app:tint="@color/red" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center"
            android:text="Accident Detected"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="15"
            android:textColor="@color/red"
            android:textSize="74sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alertSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Emergency alert will be prepared if you do not cancel."
            android:textColor="@color/muted"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelAlertButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="42dp"
            android:background="@drawable/bg_gradient_button"
            android:text="I'm Safe - Cancel Alert"
            android:textColor="#06101F"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <ProgressBar
            android:id="@+id/alertLoading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/red"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
