<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp">

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_circle_cyan_soft"
        android:padding="14dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Contact"
            android:src="@drawable/ic_phone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/contactName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/contactRelation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Relation"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/contactPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="+91 00000 00000"
            android:textColor="@color/cyan"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/editContactButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_chip_dark"
        android:contentDescription="Edit contact"
        android:padding="10dp"
        android:src="@drawable/ic_edit"
        app:tint="@color/muted" />

    <ImageButton
        android:id="@+id/deleteContactButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_chip_dark"
        android:contentDescription="Delete contact"
        android:padding="10dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/red" />
</LinearLayout>
