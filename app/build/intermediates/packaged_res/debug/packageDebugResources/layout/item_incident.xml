<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp">

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_circle_red_soft"
        android:padding="13dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Incident"
            android:src="@drawable/ic_alert" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/incidentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alert Sent"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/incidentDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="09 May 2026, 06:30 PM"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/incidentLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Location unavailable"
            android:textColor="@color/cyan"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
